# The token the platform admin gives you (EZPUG_VENUE_RELAY_TOKEN on the platform). Required.
EZPUG_RELAY_TOKEN=
# Where the platform's relay door is. Default is production.
#EZPUG_RELAY_URL=wss://api.pug.saar-lan.de/venue/relay
# The ezLAN this relay forwards to, resolved by THIS network's DNS (at the venue: the local copy).
#EZPUG_RELAY_EZLAN_URL=https://saar-lan.de
# Only if the local ezLAN serves a certificate that does not verify. Off by default.
#EZPUG_RELAY_INSECURE_TLS=1
